# CPHub grader sandbox profile — /etc/firejail/cphub.local

# Network: completely blocked
net none

# Drop root, drop all capabilities
noroot
caps.drop all

# Seccomp syscall filter
seccomp

# Timeout: 5 seconds hard limit
timeout 5

# Isolate /tmp to a private mount
private-tmp

# No device access
private-dev

# Shared libraries and /usr are read-only
read-only /usr
read-only /lib
read-only /lib64

# Additional hardening
nonewprivs
