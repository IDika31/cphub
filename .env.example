# ============================================================
# CPHub V4 — Environment Configuration
# ============================================================
# Copy file ini ke .env dan sesuaikan nilainya
#   cp .env.example .env
# ============================================================

# --- Database (native PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=cphub
DB_PASSWORD=cphub
DB_NAME=cphub
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# --- Redis (native) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# --- Frontend ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/api/auth/google/callback

# --- Codeforces OIDC ---
CF_CLIENT_ID=
CF_CLIENT_SECRET=
CF_REDIRECT_URL=http://localhost:3001/api/auth/codeforces/callback

# --- Grader ---
GRADER_MAX_CONCURRENT=5
GRADER_TIMEOUT_SECONDS=5
# Slack added before the hard kill (per testcase). Raise on a slow VPS.
GRADER_TIME_GRACE_MS=500
# 0 = measure firejail startup cost at boot; pin it only if autodetect misfires.
GRADER_SANDBOX_OVERHEAD_MS=0
# Ceiling for a client-supplied time limit.
GRADER_MAX_TIME_LIMIT_MS=15000
GRADER_MEMORY_LIMIT_MB=512
GRADER_MAX_OUTPUT_KB=256
GRADER_MAX_CODE_SIZE_KB=256
GRADER_TEMP_DIR=/tmp/cphub-grader
# Leave empty: the grader passes its own hardening flags. A profile with a
# `timeout` directive makes every run report TLE and is ignored with a warning.
GRADER_FIREJAIL_PROFILE=

# --- Compiler Paths (Arch Linux CachyOS) ---
GCC_PATH=/usr/bin/g++
PYTHON3_PATH=/usr/bin/python3
NODE_PATH=/usr/bin/node
JAVAC_PATH=/usr/bin/javac
JAVA_PATH=/usr/bin/java
FIREJAIL_PATH=/usr/bin/firejail

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=text

# --- Environment ---
ENVIRONMENT=development

# --- Codeforces official API (opsional, dari codeforces.com/settings/api) ---
# Hanya melebarkan akses ke data privat akunmu. Read publik jalan tanpa ini.
CF_API_KEY=
CF_API_SECRET=

# --- Codeforces login handle+password (submit & register contest) ---
# Codeforces tidak punya API write, jadi submit dan registrasi lewat sesi web
# (mirror m1/m3, karena codeforces.com sendiri di balik Cloudflare).
# CRED_ENC_KEY = 32 byte AES-GCM untuk mengenkripsi password yang disimpan.
# Kosong = password TIDAK PERNAH disimpan; sesi kedaluwarsa harus login ulang manual.
# Generate: openssl rand -hex 32
CRED_ENC_KEY=
